FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app

RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

# Overridden by docker-compose.yml's `command:` for the beat service; this is
# the default worker process.
CMD ["celery", "-A", "app.core.celery_app.celery_app", "worker", "--loglevel=info", \
     "-Q", "orchestration,pipeline,elevenlabs_queue", "--concurrency=8"]
