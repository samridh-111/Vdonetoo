# =========================================================
# Internal Automation Hub — Batch IVR Automation
# Copy to .env and fill in real values. Never commit .env.
# =========================================================

# --- Environment ---
ENVIRONMENT=development           # development | test | production

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_AUDIO_BUCKET=ivr-audio
SUPABASE_BATCH_BUCKET=ivr-batches

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_MAX_CONCURRENCY=8
ELEVENLABS_RATE_PER_MIN=60
ELEVENLABS_PREVIEW_TEXT="Hello, this is a preview of this voice for Automation Hub."

# --- Translation Provider (configurable) ---
TRANSLATION_PROVIDER=openai        # openai | gemini | mymemory
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# mymemory needs no API key -- a free, no-billing stand-in for demos.
# Anonymous usage is capped ~5000 chars/day; set an email below to raise
# that to ~50000/day per MyMemory's terms. Not a long-term replacement.
MYMEMORY_CONTACT_EMAIL=
# Lower these further if you're on a free-trial/low-tier API key -- a batch
# fans out one translation call per script concurrently, which can burst
# past a strict requests-per-minute limit.
TRANSLATION_MAX_CONCURRENCY=2
TRANSLATION_RATE_PER_MIN=20

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Testing (only honored when ENVIRONMENT=test) ---
IVR_TEST_FORCE_FAILURES=0
